# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# URL pública canônica desta instalação (esquema + host, sem barra final).
# É a ÚNICA fonte do host dos links de convite (/api/account/invitations): o host
# do cabeçalho da requisição NUNCA é usado. É embutida no BUILD (NEXT_PUBLIC_*):
# precisa estar no ambiente do `npm run build`. Veja docs/env.md.
NEXT_PUBLIC_APP_URL=https://crm.example.com
# (NEXT_PUBLIC_SITE_URL é só um alias legado de NEXT_PUBLIC_APP_URL — não use.)

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Alternativa à URL do app para os links de convite: hosts autorizados
# (host[:porta], separados por vírgula, sem esquema). Só é lida quando
# NEXT_PUBLIC_APP_URL NÃO está definida. Com um host, ele é usado; com vários,
# a requisição só escolhe entre os da lista. Sem nenhuma das duas, criar convite
# responde 500 com mensagem clara — não existe link para host arbitrário.
# ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Shared secret protecting POST /api/stress/run — health check
# automatizado (webhook/cron smoke tests + saúde da fila/flows/
# conversas pendentes), exibido na aba "Testes" de /ddm-logs. Generate
# any long random string:
#   openssl rand -hex 32
# See tests/stress/README.md.
# STRESS_RUN_SECRET=generate-a-long-random-secret

# Token da API de débitos do ddmacordos.com (sistema externo do mesmo
# grupo) — usado só pelo teste 8 (ddm_api_health) do health check em
# /api/stress/run. Sem ele, esse teste específico falha com "não
# configurado"; os outros continuam funcionando normalmente.
# Token da API DDM Acordos (consulta de devedor por CPF, cálculo e formalização
# de acordo pela IA). OBRIGATÓRIO para a IA de cobrança — sem ele a consulta
# e a formalização ficam desativadas (não há mais valor padrão no código).
# DDM_TOKEN / DDM_API_KEY ainda são aceitos como nomes alternativos.
DDM_ACORDOS_API_TOKEN=

# Chave da API pública (wacrm_live_...) usada pelo teste 12
# (api_v1_campaign_status) do health check em /api/stress/run — precisa
# do scope 'campaigns:read' ou 'campaigns:write'. Sem ela, esse teste
# específico falha com "não configurado"; os outros continuam
# funcionando normalmente. Crie em Settings → API keys no dashboard.
# STRESS_API_KEY=wacrm_live_your-stress-test-key

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# Maximum queue work handled concurrently by one Disparador cron tick.
# Default: 4. The database still enforces max_in_flight per WhatsApp line,
# so this does not bypass channel-level safety. Valid range: 1..50.
# DISPATCH_PROCESS_CONCURRENCY=8
#
# Per WhatsApp number (channels without a dispatch_channel_limits row; a
# row's max_in_flight always wins). Default 4 = the DB claim default. Going
# above 4 requires migration 164 (claim_dispatch_item_capped). WAHA does not
# inherit the generic value above 4 — set the _WAHA one explicitly.
# See src/lib/disparador/throughput-config.ts for the step-up procedure.
# DISPARADOR_PER_NUMBER_CONCURRENCY=4
# DISPARADOR_PER_NUMBER_CONCURRENCY_META=4
# DISPARADOR_PER_NUMBER_CONCURRENCY_WAHA=4
# DISPARADOR_TICK_BUDGET_MS=35000
# Adaptive backoff (only lowers concurrency): "0" disables.
# DISPARADOR_ADAPTIVE_BACKOFF=1
# DISPARADOR_MAX_EVENT_LOOP_LAG_MS=200
# DISPARADOR_MAX_RSS_MB=1024
# DISPARADOR_BACKOFF_COOLDOWN_SECONDS=300

# OpenAI key used by the Disparador when a campaign message has
# tipo="ia" (worker.ts / api/disparador/cron). Kept separate from the
# AI agent's OPENAI_API_KEY so each feature's spend can be tracked
# under its own OpenAI Project in the usage dashboard. Falls back to
# OPENAI_API_KEY (the AI agent's key) when unset, so existing
# environments keep working without any change.
# DISPARADOR_OPENAI_API_KEY=your-disparador-scoped-openai-key

# UTMPay API key (https://utmpay.grupoddm.ia.br) — used server-side by
# /api/disparador/utm to generate tracked short links in batch for the
# campanhas wizard's "Gerar UTM" step. Never exposed to the client;
# the browser only ever calls the internal proxy route.
# UTM_API_KEY=your-utmpay-api-key


# Required for incoming WAHA webhooks. Never sent to WAHA servers: each
# channel gets HMAC(WAHA_WEBHOOK_SECRET, channel id) as its x-webhook-secret
# and a webhook URL built from NEXT_PUBLIC_APP_URL (?channel=<id>).
# WAHA_WEBHOOK_SECRET=your-unique-webhook-secret
# Transition only: also accept the old global secret from sessions started
# before per-channel secrets. Remove after restarting every WAHA session.
# WAHA_WEBHOOK_ACCEPT_LEGACY_SECRET=true
## VoIP: server-side only. Never use NEXT_PUBLIC_ for its service secret.
VOIP_URL=http://127.0.0.1:8080
VOIP_SERVICE_SECRET=
# Configure the same secret and VOIP_AUDIO_ALLOWED_HOSTS in the Go service.
# Legacy Nest deployment: dedicated public schema and matching CRM account.
DISPATCH_SINGLE_ACCOUNT_ID=

# --- Omnichannel (Instagram / Messenger / Webchat) ---
# (a URL pública do app, NEXT_PUBLIC_APP_URL, está definida no topo deste arquivo.)
# Instagram API com Instagram Login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# App da Meta (Messenger / Facebook Login) e webhook /api/meta/webhook.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Opcional (padrão v25.0).
META_GRAPH_VERSION=

# --- Auditoria (migration 131) ---
# Assina os headers de auditoria do cliente SSR. Mesmo valor gravado em
# wacrm.audit_secrets (ver cabeçalho da migration). Mínimo 32 caracteres.
AUDIT_HEADER_SECRET=
