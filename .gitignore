# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# keep example files so forkers have a template to copy
!.env.local.example
!.env.example

# vercel
.vercel

# Claude Code local settings (per-user permission allowlist, not project config)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
install-log.txt

# supabase CLI local cache/state
supabase/.temp/

# stress test generated artifacts (CSVs, JSON results) — reproducible via
# npm run stress:generate / stress:import / stress:queue / stress:webhook
tests/stress/data/
tests/stress/results/
# stress test session cookie (see tests/stress/README.md) — a live credential
tests/stress/.session-token
