# MODELO de /etc/crm-worker/<instância>.env (modo 0600, dono crmworker). Não commitar valores reais.
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opção A de segredos (PRD 12): o worker lê o token do canal e decifra aqui. Só no piloto; depois, corretor de credenciais.
ENCRYPTION_KEY=

# Identificação (única por processo vivo) e grupo de números (vazio = números sem grupo).
DISPATCH_WORKER_ID=worker-a
DISPATCH_WORKER_GROUP=
# Quantos números este processo assume (padrão 2; os livres são pegos automaticamente, auto-balanceado).
DISPATCH_WORKER_MAX_NUMBERS=2
# Espera por envios em voo no SIGTERM (ms).
DISPATCH_WORKER_DRAIN_MS=8000

# A chave do worker é POR CONTA, no banco (PUT /api/disparador/engine). Esta variável só vale como padrão quando o banco não responde.
# DISPATCH_WORKER_ENABLED=0
