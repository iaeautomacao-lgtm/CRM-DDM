# ============================================================
# HOMOLOGACAO — primeiro deploy no dominio novo do cPanel
# ============================================================
#
# Este arquivo e um MODELO. Copie para .env NO SERVIDOR (o .env nunca
# vai pelo Git) e preencha la.
#
# Objetivo deste primeiro deploy: descobrir se a hospedagem aguenta a
# aplicacao. Node na versao certa, build sem estourar memoria, Passenger
# subindo, HTTPS, assets estaticos. Nada alem disso.
#
# REGRA DESTE DEPLOY: nao copie o .env de producao para ca.
#
# O codigo ainda fala Supabase inteiro. Com as chaves de producao, a
# aplicacao de homologacao escreve no banco real (a service_role ignora
# RLS), duplica o consumo do webhook da Meta e o worker do disparador
# pode enviar WhatsApp de verdade para contatos reais.
#
# Use os valores de placeholder abaixo. A aplicacao sobe e as telas que
# dependem do banco vao dar erro — isso e esperado e suficiente para
# validar a hospedagem.

# ============================================================
# OBRIGATORIAS — a aplicacao nao inicia sem elas
# ============================================================

# Placeholders propositais. Formato valido, projeto inexistente.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Chave NOVA, gerada so para homologacao. Nunca reaproveite a de producao.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Placeholder proposital: sem o segredo real, o webhook rejeita tudo que
# chegar. Em homologacao isso e o comportamento desejado.
META_APP_SECRET=placeholder-meta-app-secret

# ============================================================
# AMBIENTE
# ============================================================

NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://homologacao.seudominio.com.br

# ============================================================
# NAO CONFIGURE AINDA
# ============================================================
#
# Deixe fora do .env de homologacao ate a migracao para MariaDB estar
# validada:
#
#   AUTOMATION_CRON_SECRET   nao crie cron job neste dominio
#   DISPARADOR_OPENAI_API_KEY  worker do disparador desligado
#   UTM_API_KEY
#   META_APP_ID
#   VOIP_URL                 servico Go nao sobe no primeiro deploy;
#                            /api/calls/* vai dar 502, e esperado
#
# Tambem nao aponte o webhook da Meta para este dominio.
